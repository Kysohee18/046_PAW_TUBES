@startuml usecase
!theme plain
left to right direction
skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #ECFDF5
  BorderColor #059669
  FontColor #18181B
}
skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #27272A
}

title ReviewPulse SaaS — Use Case Diagram

actor "Seller" as Seller
actor "API Consumer" as Consumer
actor "Admin" as Admin

rectangle "ReviewPulse" {
  usecase "Register account" as UC1
  usecase "Log in" as UC2
  usecase "Generate API key" as UC3
  usecase "List / revoke API keys" as UC4
  usecase "Analyze product reviews" as UC5
  usecase "View analysis history" as UC6
  usecase "Read API documentation" as UC7
  usecase "List all users" as UC8
  usecase "List all API keys (any user)" as UC9
  usecase "View system-wide usage logs" as UC10
  usecase "Revoke any user's API key" as UC11
}

Seller --> UC1
Seller --> UC2
Seller --> UC3
Seller --> UC4
Seller --> UC6
Seller --> UC7
Consumer --> UC5
Consumer --> UC6

Admin --|> Seller
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11

UC3 ..> UC2 : <<requires>>
UC4 ..> UC2 : <<requires>>
UC5 ..> UC3 : <<requires>>
UC8 ..> UC2 : <<requires>>
UC9 ..> UC2 : <<requires>>
UC10 ..> UC2 : <<requires>>
UC11 ..> UC2 : <<requires>>

@enduml
